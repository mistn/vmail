# Cloudflare D1 数据库 ID（在 Cloudflare 控制台 D1 页面可找到）
D1_DATABASE_ID = "your-database-id-here"

# 邮箱域名，多个用逗号分隔，例如 "example.com,example.net"
EMAIL_DOMAIN = "your-domain.com"

# Cookie 签名密钥，随机字符串
COOKIES_SECRET = "your-cookie-secret"

# Turnstile 人机验证（可选，留空则禁用）
TURNSTILE_KEY = ""
TURNSTILE_SECRET = ""

# 站点访问密码（可选）
PASSWORD = ""

# API 每分钟请求限制（可选，默认 100）
API_RATE_LIMIT_PER_MINUTE = "100"

# 是否展示推广（可选，默认不展示）
SHOW_AFF = ""

# 是否开启 OpenAPI（可选，默认开启）
ENABLE_OPENAPI = ""
